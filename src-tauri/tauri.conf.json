{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUCIOZ OPTIMIZER",
  "version": "0.3.0",
  "identifier": "pt.lucioz.optimizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LUCIOZ OPTIMIZER",
        "width": 1440,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 700,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Diagnóstico e manutenção segura do Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Portuguese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
